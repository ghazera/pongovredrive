{
  "name": "neon-pong-overdrive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts --dev",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:network": "vitest run tests/network.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
